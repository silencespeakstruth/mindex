# EXAMPLE — mindex-embedder@igpu on an Intel Arc iGPU (Xe2) via torch XPU.
# Installed to ~/.config/mindex/embedder-igpu.env; read by the unit template.
#
# The default instance. The iGPU is otherwise idle and shares system RAM, so the
# whole 32 GiB of the discrete card stays free for the research LLM's KV cache.
# Slower per batch than the eGPU — irrelevant on the query path (one ~20-token
# text, latency-bound), noticeable on a full reindex; switch to @egpu for that.

EMBEDDER_DEVICE=xpu
# Carried over from the eGPU instance as a starting point, not a measurement:
# on shared memory the optimum may sit elsewhere. Retune here, not in the unit.
EMBEDDER_BATCH=512

# Pin the backend explicitly so device selection does not depend on enumeration
# order (the AMD card exposes no Level Zero device, but say it anyway).
ONEAPI_DEVICE_SELECTOR=level_zero:0
