# EXAMPLE — mindex-embedder@egpu on a discrete AMD card via ROCm.
# Installed to ~/.config/mindex/embedder-egpu.env; read by the unit template.
#
# Use this instance for bulk indexing, where throughput dominates. It holds
# ~6 GiB of the card, which is what the research LLM otherwise wants.

EMBEDDER_DEVICE=cuda
# 512 was the measured best throughput setting on the card this was written
# for; re-measure on yours (see perf/README.md).
EMBEDDER_BATCH=512

# ROCm / torch tuning, card- and driver-specific. /etc/environment and ~/.bashrc set these
# for interactive shells; a systemd unit inherits neither, so they are repeated
# here — dropping one changes GPU behaviour silently rather than failing.
HIP_VISIBLE_DEVICES=0
HSA_ENABLE_SDMA=0
HSA_XNACK=0
MIOPEN_FIND_MODE=2
TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1
PYTORCH_HIP_ALLOC_CONF=expandable_segments:True
ROCM_PATH=/opt/rocm
