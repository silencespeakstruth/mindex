# Copied to ~/.config/mindex/embedder.env and read by mindex-embedder.service.
# Every value has a default in server.py; this file exists so the decisions that
# are about THIS host — which device, and how much of it — are in one place
# rather than in a unit file. Keys not listed in server.py are ignored in
# silence, so a typo here reads as "the default was fine".

# The model. Must be the HF repo of the registry entry [model].id names, or
# mindex's startup handshake refuses (which is the point of the handshake).
MINDEX_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B

# What GET /v1/models reports, i.e. what [model].served_name must equal.
# Unset = the model id above.
#MINDEX_EMBED_SERVED_NAME=qwen3-embedding-0.6b

# cuda covers ROCm too (torch's ROCm build keeps the cuda device string).
MINDEX_EMBED_DEVICE=cuda
# bfloat16, NOT float16. Qwen3 is trained in bf16 and in fp16 returns NaN rows
# for the longest chunks — see server.py's comment on DTYPE. Same memory, same
# speed, and the failure it avoids is silent.
MINDEX_EMBED_DTYPE=bfloat16

# The GPU batch is formed by a TOKEN budget, not a text count: activation memory
# scales with rows x sequence length, so a fixed count is sized for the average
# chunk and OOMs on the long tail. Budget in tokens per forward pass.
MINDEX_EMBED_TOKEN_BUDGET=16384
# Hard cap on rows per pass regardless of length, so short texts do not form
# batches of thousands where padding to the group's longest member dominates.
MINDEX_EMBED_MAX_ROWS=128

# Truncation, in tokens. MUST be >= mindex's [slicer].max_doc_chunk_tokens
# (1024 by default), or long documentation chunks are silently embedded from
# their first N tokens — no error, just worse retrieval for the longest chunks.
# Do not raise it "for headroom": it is the second factor in the activation peak.
MINDEX_EMBED_MAX_SEQ=1024

# Return the allocator's pool to the driver after a request that grew it past
# this many MiB. Defaults to 0 (off) because on ROCm the call was measured to
# corrupt in-flight output — read server.py before switching it on.
#MINDEX_EMBED_TRIM_MIB=0
