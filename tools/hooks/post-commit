#!/usr/bin/env bash
# mindex post-commit hook (opt-in) — keep the index live as you commit.
#
# After each commit it reindexes the files that commit changed (added/modified),
# soft-deletes the ones it removed, and refreshes the git-history channel — so
# mindex keeps matching the tree without a manual reindex.
#
# WHY A FAILURE HERE IS SAFE: git invokes post-commit *after* the commit exists
# and, per githooks(5), it "cannot affect the outcome of git commit" — the exit
# status is ignored. So this script reports problems loudly and exits non-zero
# rather than hiding them, and your commit still stands either way. Nothing here
# can cost you work.
#
# This hook is OFF by default — other contributors are unaffected unless they
# install it themselves. To enable, from the repo root pick ONE:
#     ln -s ../../tools/hooks/post-commit .git/hooks/post-commit   # symlink
#     git config core.hooksPath tools/hooks                        # whole dir
# (core.hooksPath replaces the entire hooks directory, so only use it if you
# don't have other .git/hooks scripts.)
#
# Requirements:
#   - `mindex-index` INSTALLED and on PATH. This is assumed, not worked around:
#     you installed a hook that drives it, so its absence is a broken setup and
#     is reported as an error rather than skipped in silence.
#     Install with: cargo install --path tools/indexer
#   - mindex running and reachable at $MINDEX_SERVER (a server that is merely
#     down is a warning — that is a passing condition, not a broken setup).
#
# A repo with no `.mindex` is skipped quietly and successfully: that is not a
# misconfiguration but simply a repository this hook has no work in, which
# matters when the hook is installed globally via core.hooksPath.
#
# Config (same MINDEX_* conventions as tools/search and the MCP servers):
#   MINDEX_SERVER     mindex URL (default https://127.0.0.1:11111)
#   MINDEX_NO_VERIFY  truthy → skip TLS verification (self-signed cert)

set -u

SERVER="${MINDEX_SERVER:-https://127.0.0.1:11111}"

warn() {
    printf '  [mindex] %s\n' "$1" >&2
}

# A broken setup, as opposed to a passing failure. Exits non-zero, which git
# ignores for post-commit — the commit is already made and stays made.
die() {
    printf '  [mindex] ERROR: %s\n' "$1" >&2
    exit 1
}

# Show the tool's own words rather than "it failed": "is mindex up?" is a guess,
# and the process already knows the answer.
report() {
    local what=$1 output=$2
    if [[ -n $output ]]; then
        warn "$what failed:"
        printf '  [mindex]   %s\n' "$output" >&2
    else
        warn "$what failed (no output; is mindex reachable at $SERVER?)"
    fi
}

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" ||
    die "not inside a git repository (this script is a git hook)"
cd "$repo_root" || die "cannot enter the repository root $repo_root"

# Not a mindex project — nothing to do, and nothing wrong.
[[ -f "$repo_root/.mindex" ]] || exit 0

command -v mindex-index >/dev/null 2>&1 ||
    die "mindex-index is not on PATH. Install it with 'cargo install --path tools/indexer', or uninstall this hook."

# The GUID comes from mindex-index, the one .mindex parser — a second parser here
# is how the two drift apart (and the delete endpoint below needs the same value
# the reindex uses).
guid="$(mindex-index --print-guid --root . 2>&1)" ||
    die ".mindex is present but unusable: $guid"

# TLS + verify flags shared by the CLI (reindex) and curl (delete).
index_flags=(--server "$SERVER")
curl_flags=(--silent --show-error)
case "${MINDEX_NO_VERIFY:-}" in
    1 | true | yes | on | TRUE | YES | ON)
        index_flags+=(--no-verify)
        curl_flags+=(--insecure)
        ;;
esac

# Partition this commit's changes. name-status with -r yields one record per file:
#   A<TAB>path | M<TAB>path | D<TAB>path | R<score><TAB>old<TAB>new
# Renames touch both sides: index the new path, delete the old.
changed=()
deleted=()
while IFS=$'\t' read -r status p1 p2; do
    case "$status" in
        A* | M*) changed+=("$p1") ;;
        D*) deleted+=("$p1") ;;
        R* | C*)
            changed+=("$p2")
            [[ "$status" == R* ]] && deleted+=("$p1")
            ;;
    esac
done < <(git diff-tree --no-commit-id --name-status -r HEAD)

failures=0

# ── Reindex added/modified files (mindex-index hash-skips unchanged ones) ──────
# --include narrows the run to this commit and *replaces* any include_paths in
# .mindex; its exclude_paths still apply, which is what keeps excluded trees out.
if ((${#changed[@]} > 0)); then
    include_flags=()
    for p in "${changed[@]}"; do
        include_flags+=(--include "$p")
    done
    if ! out="$(mindex-index "${index_flags[@]}" --root . "${include_flags[@]}" 2>&1 >/dev/null)"; then
        report "reindex of ${#changed[@]} changed file(s)" "$out"
        ((failures++))
    fi
fi

# ── Refresh the git history channel ───────────────────────────────────────────
# A separate invocation, not a flag on the one above: that run is narrowed to
# this commit's files with --include, and the same narrowing would filter every
# *other* commit's paths down to them and drop nearly the whole history as out
# of scope. --history-only skips the tree entirely, so this costs one git walk
# and one request. It also RESTRICTS the run rather than switching the channel
# on, so this stays a no-op until the operator sets `history = true` in the
# indexer config — a hook must not enable a channel behind their back.
if ! out="$(mindex-index "${index_flags[@]}" --root . --history-only 2>&1 >/dev/null)"; then
    report "git history refresh" "$out"
    ((failures++))
fi

# ── Soft-delete removed files via the existing delete-files endpoint ───────────
if ((${#deleted[@]} > 0)); then
    # Build {"include":{"paths":["a","b",...]}} — source paths don't contain quotes.
    json_paths=""
    for p in "${deleted[@]}"; do
        json_paths+="\"$p\","
    done
    json_paths="${json_paths%,}"
    body="{\"include\":{\"paths\":[$json_paths]}}"
    if ! out="$(curl "${curl_flags[@]}" -X DELETE \
        -H 'Content-Type: application/json' \
        -d "$body" \
        "$SERVER/projects/$guid/files" 2>&1 >/dev/null)"; then
        report "soft-delete of ${#deleted[@]} removed file(s)" "$out"
        ((failures++))
    fi
fi

# Non-zero on any failure so a CI wrapper or a `git commit` run by hand can see
# it. git itself ignores this for post-commit; the commit is already made.
((failures == 0)) || exit 1
exit 0
