{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    // `out/` and not `dist/`: dist/ is esbuild's, and holds exactly the one bundled
    // file the extension runs. What tsc emits here is only for `node --test`, and is
    // never packaged.
    "outDir": "out",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  // `src/webview` is the browser half and is compiled by tsconfig.webview.json
  // instead: it needs the DOM lib and ES modules, neither of which the host build
  // should admit. `src/shared` is deliberately *not* excluded — both projects
  // compile it, so the host, the webview and `node --test` share one copy.
  "include": ["src"],
  "exclude": ["src/webview"]
}
