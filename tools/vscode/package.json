{
  "name": "mindex-vscode",
  "displayName": "MINDex",
  "description": "Ask your codebase: semantic search with live preview, and a local model that investigates and writes a cited report. Plus drift detection and selective reindexing against a MINDex server.",
  "version": "1.1.0",
  "publisher": "mindex",
  "license": "MIT",
  "author": {
    "name": "Сергей Боголюбов"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/silencespeakstruth/mindex.git",
    "directory": "tools/vscode"
  },
  "homepage": "https://github.com/silencespeakstruth/mindex",
  "bugs": {
    "url": "https://github.com/silencespeakstruth/mindex/issues"
  },
  "keywords": [
    "code-search",
    "semantic-search",
    "codebase-search",
    "rag",
    "embeddings",
    "ollama",
    "local-llm",
    "mindex"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.mindex"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mindex",
          "title": "MINDex",
          "icon": "media/mindex-activity.svg"
        }
      ]
    },
    "views": {
      "mindex": [
        {
          "id": "mindexAsk",
          "name": "Ask",
          "type": "webview",
          "icon": "$(comment-discussion)",
          "when": "mindex.hasProject"
        },
        {
          "id": "mindexDrift",
          "name": "Drift",
          "icon": "$(git-compare)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mindexDrift",
        "when": "mindex.hasProject",
        "contents": "Drift is the difference between your working tree and what the MINDex server has indexed — files you edited since the last index, files never indexed, and files the index still holds after you deleted them.\nNothing is checked on its own. Press below and the extension hashes your files and asks the server what it holds; the answer arrives in a few seconds as four groups you can act on.\n[Check Drift](command:mindex.checkDrift)\nRead-only: checking changes nothing on the server."
      },
      {
        "view": "mindexDrift",
        "when": "!mindex.hasProject",
        "contents": "No usable .mindex project file at the workspace root.\nThat file is what says this folder is a MINDex project: a GUID identifying it on the server, plus the globs deciding which files belong to the index.\n[Create .mindex File](command:mindex.createProjectFile)\nGenerates a GUID and a commented template — edit the excludes, save, and the extension picks it up."
      }
    ],
    "commands": [
      {
        "command": "mindex.createProjectFile",
        "title": "Create a .mindex Project File",
        "category": "MINDex",
        "icon": "$(new-file)"
      },
      {
        "command": "mindex.ask",
        "title": "Ask: Search or Research",
        "icon": "$(comment-discussion)",
        "category": "MINDex"
      },
      {
        "command": "mindex.search",
        "title": "Search the Index",
        "category": "MINDex",
        "icon": "$(search)"
      },
      {
        "command": "mindex.research",
        "title": "Research a Question",
        "category": "MINDex",
        "icon": "$(beaker)"
      },
      {
        "command": "mindex.checkDrift",
        "title": "Check Drift Against Working Tree",
        "category": "MINDex",
        "icon": "$(git-compare)"
      },
      {
        "command": "mindex.reindexSelected",
        "title": "Reindex Checked Files",
        "category": "MINDex",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "mindex.syncAll",
        "title": "Sync All Drift",
        "category": "MINDex",
        "icon": "$(sync)"
      },
      {
        "command": "mindex.reindexAllDrift",
        "title": "Reindex All Stale and Missing",
        "category": "MINDex",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "mindex.reindexCurrentFile",
        "title": "Reindex This File",
        "category": "MINDex",
        "icon": "$(save)"
      },
      {
        "command": "mindex.forceReindexCurrentFile",
        "title": "Force Reindex This File",
        "category": "MINDex",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "mindex.forceReindexProject",
        "title": "Force Reindex Whole Project",
        "category": "MINDex",
        "icon": "$(warning)"
      },
      {
        "command": "mindex.deleteOrphanedSelected",
        "title": "Delete Checked Orphans from Index",
        "category": "MINDex",
        "icon": "$(trash)"
      },
      {
        "command": "mindex.cancelIndexing",
        "title": "Cancel In-Flight Indexing",
        "category": "MINDex",
        "icon": "$(stop-circle)"
      },
      {
        "command": "mindex.refreshStatus",
        "title": "Refresh Server Status",
        "category": "MINDex",
        "icon": "$(refresh)"
      },
      {
        "command": "mindex.retryAllFailed",
        "title": "Retry All Failed Files",
        "category": "MINDex",
        "icon": "$(debug-restart)"
      },
      {
        "command": "mindex.retryFile",
        "title": "Retry This File",
        "category": "MINDex",
        "icon": "$(debug-restart)"
      },
      {
        "command": "mindex.openStatus",
        "title": "Show Server Status",
        "category": "MINDex",
        "icon": "$(pulse)"
      },
      {
        "command": "mindex.openIndexing",
        "title": "Show Indexing",
        "category": "MINDex",
        "icon": "$(pulse)"
      },
      {
        "command": "mindex.openResearchHistory",
        "title": "Show Research History",
        "category": "MINDex",
        "icon": "$(history)"
      },
      {
        "command": "mindex.pickResearchContext",
        "title": "Pick Research Context",
        "category": "MINDex",
        "icon": "$(references)"
      },
      {
        "command": "mindex.openResearchReport",
        "title": "Open Research Report",
        "category": "MINDex",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mindex.challengeResearchRun",
        "title": "Challenge Research Report",
        "category": "MINDex",
        "icon": "$(shield)"
      },
      {
        "command": "mindex.activeResearchRuns",
        "title": "Active Research Runs",
        "category": "MINDex",
        "icon": "$(record)"
      },
      {
        "command": "mindex.openSettings",
        "title": "Open Settings",
        "category": "MINDex",
        "icon": "$(gear)"
      },
      {
        "command": "mindex.setToken",
        "title": "Set Bearer Token",
        "category": "MINDex",
        "icon": "$(key)"
      },
      {
        "command": "mindex.mintAgentToken",
        "title": "Issue a Token for an Agent",
        "category": "MINDex",
        "icon": "$(key)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mindex.openStatus",
          "when": "view == mindexAsk",
          "group": "navigation@1"
        },
        {
          "command": "mindex.openResearchHistory",
          "when": "view == mindexAsk",
          "group": "navigation@2"
        },
        {
          "command": "mindex.openSettings",
          "when": "view == mindexAsk",
          "group": "navigation@4"
        },
        {
          "command": "mindex.createProjectFile",
          "when": "view == mindexDrift && !mindex.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "mindex.checkDrift",
          "when": "view == mindexDrift && mindex.hasProject",
          "group": "navigation@1"
        },
        {
          "command": "mindex.reindexSelected",
          "when": "view == mindexDrift && mindex.hasProject",
          "group": "navigation@2"
        },
        {
          "command": "mindex.deleteOrphanedSelected",
          "when": "view == mindexDrift && mindex.hasProject",
          "group": "navigation@3"
        },
        {
          "command": "mindex.syncAll",
          "when": "view == mindexDrift && mindex.hasProject",
          "group": "1_reindex@1"
        },
        {
          "command": "mindex.reindexAllDrift",
          "when": "view == mindexDrift && mindex.hasProject",
          "group": "1_reindex@2"
        },
        {
          "command": "mindex.reindexCurrentFile",
          "when": "view == mindexDrift && mindex.hasProject",
          "group": "1_reindex@3"
        },
        {
          "command": "mindex.cancelIndexing",
          "when": "view == mindexDrift && mindex.hasProject",
          "group": "1_reindex@4"
        },
        {
          "command": "mindex.forceReindexCurrentFile",
          "when": "view == mindexDrift && mindex.hasProject",
          "group": "9_force@1"
        },
        {
          "command": "mindex.forceReindexProject",
          "when": "view == mindexDrift && mindex.hasProject",
          "group": "9_force@2"
        },
        {
          "command": "mindex.openSettings",
          "when": "view == mindexDrift",
          "group": "9_force@9"
        }
      ],
      "commandPalette": [
        {
          "command": "mindex.retryFile",
          "when": "false"
        },
        {
          "command": "mindex.openResearchReport",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "mindex.challengeResearchRun",
          "when": "resourceScheme == mindex-research",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mindex.search",
        "key": "ctrl+alt+/"
      },
      {
        "command": "mindex.research",
        "key": "ctrl+alt+."
      },
      {
        "command": "mindex.openResearchHistory",
        "key": "ctrl+alt+,"
      }
    ],
    "configuration": {
      "title": "MINDex",
      "properties": {
        "mindex.serverUrl": {
          "type": "string",
          "default": "https://127.0.0.1:11111",
          "description": "Base URL of the MINDex server."
        },
        "mindex.noVerify": {
          "type": "boolean",
          "default": false,
          "description": "Skip TLS certificate verification (self-signed server cert)."
        },
        "mindex.caCert": {
          "type": "string",
          "default": "",
          "description": "Path to a CA certificate (PEM) to trust for the server, e.g. the mkcert root CA."
        },
        "mindex.tokenWarningHours": {
          "type": "number",
          "default": 24,
          "minimum": 0,
          "maximum": 720,
          "description": "How long before a bearer token expires to start showing a warning in the status bar (0 disables the early notice). Under an hour the warning turns red regardless. The token itself is not a setting — it is stored in the OS keychain by “MINDex: Set Bearer Token”, so that Settings Sync cannot carry a credential between machines."
        },
        "mindex.statusPollSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "maximum": 3600,
          "description": "How often to re-check server health in the background, in seconds (0 disables it). This is what lets the Ask view stop offering Research when the server's Ollama goes away, and disable itself entirely when a required dependency does. Each poll is a handful of small local requests."
        },
        "mindex.requestTimeoutSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 0,
          "maximum": 600,
          "description": "How long to wait for an ordinary request before giving up, in seconds (0 waits forever). Health polls use a shorter deadline of their own. Streaming research and indexing runs are not bounded by this — see mindex.streamIdleTimeoutSeconds.",
          "scope": "machine-overridable"
        },
        "mindex.streamIdleTimeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 0,
          "maximum": 3600,
          "description": "How long a streaming research or indexing run may send nothing at all before the connection is treated as dead, in seconds (0 waits forever). This is an idle clock, not a total one: a long run that keeps reporting progress is never cut off. Raise it if a slow model on loaded hardware is being dropped mid-run.",
          "scope": "machine-overridable"
        },
        "mindex.indexingPanel": {
          "type": "string",
          "enum": [
            "beside",
            "active",
            "manual"
          ],
          "default": "beside",
          "enumDescriptions": [
            "Open it in a column beside the editor, without taking focus.",
            "Open it in the active editor group, without taking focus.",
            "Never open it on its own — use “MINDex: Show Indexing”."
          ],
          "description": "Where the live Indexing panel opens when a reindex starts. It shows what the server streams while it works: the files going through, the embed rate, per-language chunk and symbol counts, and a summary when the run ends."
        },
        "mindex.topK": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "Default number of search results to request. The Ask form's slider starts here; its ceiling comes from the server's own search.max_top_k."
        },
        "mindex.batchSize": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 10000,
          "markdownDescription": "Files per `/index` request when reindexing. Smaller batches report progress more often: the server emits one `embedded` event per completed embed batch, so a whole reindex sent as one request reports its GPU pass exactly once, on completion. Measured on this stack (14 files, 173 chunks): 14 files/request took 18.7 s and produced 1 progress event; 5 took 17.8 s and 3 events; 2 took 17.1 s and 7 events — so splitting cost no throughput at all here. Raise it for bulk runs on a fast GPU, where larger `/encode` batches do pay."
        },
        "mindex.researchModel": {
          "type": "string",
          "default": "",
          "description": "Default Ollama model for Research (pre-fills the form; empty = use the server's [research].default_model)."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p . --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "build": "node esbuild.mjs",
    "compile": "npm run typecheck && npm run build",
    "watch": "node esbuild.mjs --watch",
    "test": "tsc -p . && node --test \"out/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "vscode:prepublish": "npm run build -- --production",
    "package": "npm run check && vsce package",
    "icons": "rsvg-convert -w 128 -h 128 media/icon.svg -o media/icon.png"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.11.0",
    "@types/picomatch": "^3.0.1",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "3.9.2",
    "devicon": "^2.17.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "marked": "^16.4.2",
    "picomatch": "^4.0.2",
    "prettier": "^3.9.5",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.64.0",
    "yaml": "^2.9.0"
  },
  "icon": "media/icon.png"
}
