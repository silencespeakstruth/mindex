# Everything the extension host does not run. `vsce` packages the whole folder by
# default, so this file — not .gitignore — is what keeps sources, dev tooling and
# node_modules out of the .vsix.
#
# What ships is `dist/extension.js` (one esbuild bundle) plus `media/`. Nothing is
# resolved from `node_modules` at runtime any more — `yaml` and `picomatch` are bundled
# into the host, `marked` into the Research page, and the codicon font and stylesheet
# are copied into `media/codicons/` by the build. That is not tidiness: the previous
# arrangement excluded `node_modules/**` wholesale while `mindexFile.ts` did
# `require("yaml")`, so the published .vsix could not activate at all — a failure
# invisible in development, where the directory is simply there. A bundle cannot fail
# that way; an unresolved import is a build error.

.vscode/**
.gitignore
.prettierignore
.prettierrc.json
eslint.config.mjs
esbuild.mjs
tsconfig.json
tsconfig.webview.json
node_modules/**
src/**

# tsc's output. It exists only so `node --test` has something to run; the extension
# runs the esbuild bundle in dist/.
out/**

# Tool caches. They are gitignored, so CI never sees them and a clean checkout packs
# fine — which is exactly why this went unnoticed: a maintainer running mypy or ruff
# from this directory shipped 256 KB of .mypy_cache inside the .vsix, and only a local
# `npm run package` could produce it.
.mypy_cache/**
.ruff_cache/**
.pytest_cache/**
.eslintcache

**/*.vsix
